# Base URL of your Wishlist server (used for OAuth redirect URLs)
APP_URL=http://192.168.1.100:3000
PORT=3000
DATA_DIR=/data
SESSION_SECRET=replace-with-a-random-secret-string

# Optional OAuth 2.0 Providers (local email/password sign-in works out of the box!)
# Google OAuth Callback URL: <APP_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth Callback URL: <APP_URL>/api/auth/oauth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Login with Amazon OAuth Callback URL: <APP_URL>/api/auth/oauth/amazon/callback
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
