<?xml version="1.0"?>
<Container version="2">
  <Name>family-wishlist</Name>
  <Repository>family-wishlist:latest</Repository>
  <Registry/>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Overview>Self-hosted spoiler-free family wishlist web app with multi-store URL fetching, Things To Get Me list import, OAuth (Google, Facebook, Amazon), and no-login guest reservations.</Overview>
  <Category>Tools:Productivity</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <Config Name="WebUI Port" Target="3000" Default="3000" Mode="tcp" Description="HTTP port for Family Wishlist" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="App Data (/data)" Target="/data" Default="/mnt/user/appdata/family-wishlist" Mode="rw" Description="Persistent SQLite database storage" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/family-wishlist</Config>
  <Config Name="APP_URL" Target="APP_URL" Default="http://localhost:3000" Mode="" Description="Public/LAN base URL used for OAuth callbacks" Type="Variable" Display="always" Required="true" Mask="false">http://localhost:3000</Config>
  <Config Name="SESSION_SECRET" Target="SESSION_SECRET" Default="change-me-on-unraid" Mode="" Description="Secret used to sign session cookies" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="GOOGLE_CLIENT_ID" Target="GOOGLE_CLIENT_ID" Default="" Mode="" Description="Google OAuth Client ID (optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="GOOGLE_CLIENT_SECRET" Target="GOOGLE_CLIENT_SECRET" Default="" Mode="" Description="Google OAuth Client Secret (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="FACEBOOK_CLIENT_ID" Target="FACEBOOK_CLIENT_ID" Default="" Mode="" Description="Facebook OAuth App ID (optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="FACEBOOK_CLIENT_SECRET" Target="FACEBOOK_CLIENT_SECRET" Default="" Mode="" Description="Facebook OAuth App Secret (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
  <Config Name="AMAZON_CLIENT_ID" Target="AMAZON_CLIENT_ID" Default="" Mode="" Description="Login with Amazon Client ID (optional)" Type="Variable" Display="always" Required="false" Mask="false"/>
  <Config Name="AMAZON_CLIENT_SECRET" Target="AMAZON_CLIENT_SECRET" Default="" Mode="" Description="Login with Amazon Client Secret (optional)" Type="Variable" Display="always" Required="false" Mask="true"/>
</Container>
